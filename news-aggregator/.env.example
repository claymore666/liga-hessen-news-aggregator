# Liga Hessen News Aggregator - Environment Configuration

# =============================================================================
# Database Configuration (PostgreSQL required)
# =============================================================================

POSTGRES_PASSWORD=your-secure-password

# =============================================================================
# LLM Configuration
# =============================================================================

# Ollama endpoint and model
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss-120b

# OpenRouter (Cloud LLM) - Fallback provider
# Get your API key at https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# =============================================================================
# Classifier Configuration
# =============================================================================

# Classifier API URL (Docker internal or external)
CLASSIFIER_URL=http://host.docker.internal:8082
CLASSIFIER_THRESHOLD=0.8
# Per-request timeout for /classify, in seconds. The classifier embeds on every
# call, so this must tolerate a loaded CPU embedding backend.
CLASSIFIER_TIMEOUT=120
CLASSIFIER_ENABLED=true
CLASSIFIER_USE_PRIORITY=false
CLASSIFIER_USE_AK=false

# =============================================================================
# Worker/Scheduler Control
# =============================================================================

# Set to false to disable for manual testing (QA/dev)
SCHEDULER_ENABLED=true
LLM_WORKER_ENABLED=true
CLASSIFIER_WORKER_ENABLED=true

# =============================================================================
# GPU1 Power Management (Wake-on-LAN)
# =============================================================================

GPU1_WOL_ENABLED=true
GPU1_MAC_ADDRESS=58:47:ca:7c:18:cc
GPU1_BROADCAST=255.255.255.255
GPU1_SSH_HOST=192.168.0.141
GPU1_SSH_USER=ligahessen
GPU1_AUTO_SHUTDOWN=true
GPU1_IDLE_TIMEOUT=60
GPU1_WAKE_INTERVAL=3600
GPU1_WAKE_TIMEOUT=120
GPU1_ACTIVE_HOURS_START=7
GPU1_ACTIVE_HOURS_END=16
GPU1_ACTIVE_WEEKDAYS_ONLY=true

# =============================================================================
# Application Settings
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Redis URL for caching and task queues
REDIS_URL=redis://redis:6379/0

# Max concurrent Playwright browser instances
BROWSER_POOL_MAX=2

# Days to look back for duplicate detection
DUPLICATE_CHECK_DAYS=7

# Title pre-filter (disabled by default - can't achieve 0 false negatives)
TITLE_PREFILTER_ENABLED=false
TITLE_PREFILTER_MODEL=qwen3:8b

# LAN interface for macvlan network (Wake-on-LAN)
LAN_INTERFACE=eth0

# =============================================================================
# Security
# =============================================================================

# API key for admin endpoints (optional, if unset all requests are allowed)
ADMIN_API_KEY=

# CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
